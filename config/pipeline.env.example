# Copy this file to .env in the repo root and fill in real values.
# .env is gitignored — never commit real credentials.

# --- LLM (chapter-marking only) ---
# Shared, budget-capped demo-portfolio litellm-proxy key. Scoped to one model.
LLM_BASE_URL=https://llm-34a13a96.bunsenbrenner.org/v1
LLM_MODEL=local-devstral-small2
LLM_API_KEY=

# --- whisper.cpp (local ASR) ---
WHISPER_CLI_PATH=vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=vendor/whisper.cpp/models/ggml-tiny.en.bin

# --- Piper (optional local TTS, only used with --with-announcements) ---
PIPER_BIN=.venv/bin/piper
PIPER_MODEL_PATH=vendor/piper-voices/en_US-amy-low.onnx
